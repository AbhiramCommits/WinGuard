    "DedupeWindowSeconds": 60,
    "CorrelationBonusPerExtraRule": 8,
    "MaxCorrelationBonus": 25,
    "ProtectedProcessBonus": 10,
    "TrustedSignerRelief": 5,
    "UntrustedSignerSurcharge": 5,
    "MediumThreshold": 25,
    "HighThreshold": 50,
    "CriticalThreshold": 75,
    "Rules": {
      "R001": { "Enabled": true, "BaseWeight": 45 },
      "R002": { "Enabled": true, "BaseWeight": 60 },
      "R003": { "Enabled": true, "BaseWeight": 65 },
      "R004": { "Enabled": true, "BaseWeight": 75 },
      "R005": { "Enabled": true, "BaseWeight": 55 },
      "R006": { "Enabled": true, "BaseWeight": 70 }
    }
  }
