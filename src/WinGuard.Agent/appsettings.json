{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Win32Telemetry": {
    "EtwSessionName": "WinGuardKernelProcess",
    "PollInterval": "00:00:30",
