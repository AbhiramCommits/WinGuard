{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Win32Telemetry": {
    "EtwSessionName": "WinGuardKernelProcess",
    "PollInterval": "00:00:30",
    "EnableEtw": true,
    "MaxHashedModulesPerProcess": 32,
    "MaxTextSectionBytes": 8388608,
    "TargetProcessNames": []
  },
  "Replay": {
    "CorpusPath": "data/corpus/labeled.jsonl",
    "RatePerSecond": 0,
    "Loop": false
  },
  "Detection": {
    "AllowedModuleRoots": [
      "C:\\Windows\\System32",
      "C:\\Windows\\SysWOW64",
      "C:\\Windows\\WinSxS",
      "C:\\Windows\\Microsoft.NET",
      "C:\\Program Files",
      "C:\\Program Files (x86)"
    ],
    "ProtectedProcessNames": [
      "cs2.exe",
      "csgo.exe",
      "r5apex.exe",
      "valorant-win64-shipping.exe",
      "fortniteclient-win64-shipping.exe",
      "game.exe"
