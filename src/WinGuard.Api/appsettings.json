{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite",
    "MigrateOnStartup": true
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=data/winguard.db",
    "SqlServer": "Server=(localdb)\\MSSQLLocalDB;Database=WinGuard;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Security": {
    "Signing": {
      "Enabled": true,
      "MaxClockSkewSeconds": 300,
      "NonceCacheSeconds": 600,
      "MasterSecret": "dev-only-master-secret-change-me",
      "HostKeys": {},
      "ProtectedPaths": [ "/api/v1/heartbeat", "/api/v1/events" ],
      "ExemptPaths": [ "/healthz", "/api/v1/hosts/register" ],
      "EnrollmentSecret": "",
      "MaxRequestBodyBytes": 1048576
    },
    "Mtls": {
      "Enabled": false,
      "AllowUntrustedCertificates": false
    }
  }
}
