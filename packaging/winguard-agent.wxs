<?xml version="1.0" encoding="UTF-8"?>
<!--
  WinGuard agent MSI (WiX Toolset v3, x64).

  packaging/build-msi.ps1 publishes the agent, harvests the published files into
  a generated `HarvestedAgentFiles` component group with `heat`, then links this
  file with that harvest. This file owns:

    * the install layout (Program Files\WinGuard\Agent + a data directory),
    * the Windows Service registration, running as **LocalService** (least
      privilege at runtime: no administrative rights beyond the process/ETW
      access the collector requests),
    * stop-on-upgrade / remove-on-uninstall behaviour,
    * automatic service restart on failure.

  Build:
    pwsh -File packaging/build-msi.ps1 -Configuration Release
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <Product Id="*"
           Name="WinGuard Agent"
           Language="1033"
           Version="1.0.0.0"
           Manufacturer="WinGuard"
           UpgradeCode="6E4B7C2A-9F31-4E77-9C4A-3D5B8A1F0C21">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64"
             Description="WinGuard endpoint integrity agent"
             Comments="Anti-cheat-style tamper detection agent for Windows endpoints." />

    <MajorUpgrade DowngradeErrorMessage="A newer version of the WinGuard Agent is already installed."
                  AllowSameVersionUpgrades="yes" />

    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="WinGuard">
          <Directory Id="AgentFolder" Name="Agent" />
          <Directory Id="DataFolder" Name="data" />
        </Directory>
      </Directory>
    </Directory>

    <DirectoryRef Id="AgentFolder">
      <!--
        The agent executable is also the service binary, so it is excluded from
        the harvested component group (heat -x) and declared here together with
        the service it hosts.
      -->
      <Component Id="AgentServiceComponent" Guid="A1C4F3D2-58B7-4E19-8C3A-6D2E9F7B0A44">
        <File Id="AgentExecutable"
              Source="$(var.PublishDir)\WinGuard.Agent.exe"
              KeyPath="yes" />

        <ServiceInstall Id="WinGuardAgentService"
                        Name="WinGuardAgent"
                        DisplayName="WinGuard Endpoint Integrity Agent"
                        Description="Collects process, module and code-signing telemetry and reports tamper indicators to the WinGuard API."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalService"
                        Vital="yes" />

        <!-- Stop on upgrade/uninstall instead of orphaning a running service. -->
        <ServiceControl Id="WinGuardAgentServiceControl"
                        Name="WinGuardAgent"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />

        <util:ServiceConfig ServiceName="WinGuardAgent"
                            FirstFailureActionType="restart"
                            SecondFailureActionType="restart"
                            ThirdFailureActionType="none"
                            RestartServiceDelayInSeconds="60"
                            ResetPeriodInDays="1" />
      </Component>

      <!-- Directory the service spools detection batches into while offline. -->
      <Component Id="SpoolDirectoryComponent" Guid="F2B8E6A1-3C5D-4A97-B1E4-7F90C2D5A6B3">
        <CreateFolder Directory="DataFolder" />
      </Component>
    </DirectoryRef>

    <Feature Id="AgentFeature"
             Title="WinGuard Agent"
             Description="Installs the WinGuard endpoint integrity agent and its Windows Service."
             Level="1"
             ConfigurableDirectory="INSTALLFOLDER"
             AllowAdvertise="no"
             Display="expand"
             Absent="disallow">
      <ComponentRef Id="AgentServiceComponent" />
      <ComponentRef Id="SpoolDirectoryComponent" />
      <!-- Generated by `heat` from the published output. -->
      <ComponentGroupRef Id="HarvestedAgentFiles" />
    </Feature>
  </Product>
</Wix>
